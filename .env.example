# ============================================================
#  Copy to .env for local work. serve.js reads this file at startup
#  without overriding anything already set in the real environment.
#  .env is gitignored — never commit a real secret.
# ============================================================

# ---- Database ----
# Leave DATABASE_URL unset to use SQLite in data/ (fine for a single
# on-premise server with a real disk). Set it to use Postgres, which is
# what a cloud deployment wants: most platforms have an ephemeral
# filesystem, and an SQLite file there disappears on the next restart.
# DATABASE_URL=postgresql://user:password@host:5432/schooldb

# Which SQLite file to use, when not on Postgres. One file per school.
# SCHOOL_DB=school.db

# TLS to the database. Left unset, the connection VERIFIES the server
# certificate whenever the connection string implies TLS — which is what
# you want against Neon, Supabase, Render or RDS, all of which present
# publicly-trusted certificates. This connection carries every student
# record; do not weaken it without a reason.
#
# End the connection string with ?sslmode=verify-full, not ?sslmode=require.
# `pg` currently treats require as an alias for verify-full and warns that
# in pg v9 it will switch to libpq semantics, where require means "encrypt
# but do not check the certificate". Writing verify-full says what we
# actually mean and survives that change.
#
#   PGSSL=no-verify   encrypt but skip certificate checks. Only for a
#                     self-signed server. A real downgrade.
#   PGSSL=disable     no TLS at all. Local development only.
# PGSSL=

# ---- First administrator ----
# Only used on an instance that has no accounts at all: serve.js creates
# this account on first boot, so a platform where running a one-off
# command is awkward can still be provisioned. It never overwrites an
# existing account.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_NAME=Office Superintendent

# ---- Server ----
# PORT is usually supplied by the platform. When it is set, the server
# binds 0.0.0.0 instead of loopback.
# PORT=5490
# HOST=0.0.0.0

# How long a sign-in lasts, in days.
# SESSION_DAYS=7

# Largest school data file accepted by the importer, in MB.
# MAX_UPLOAD_MB=25

# Set to 1 only for local HTTP testing: it drops the Secure flag from the
# session cookie. Never set this on a deployment.
# FORCE_INSECURE_COOKIE=0
