# ============================================================
#  Line endings.
#
#  Without this file, what lands in the repository depends on each
#  developer's core.autocrlf setting. That is fine until it isn't: a
#  clone with autocrlf=false commits CRLF, and the files below are then
#  EXECUTED on Linux, where a trailing \r is a syntax error.
#
#  The failure is memorable. A workflow whose `run:` block has CRLF fails
#  with `$'\r': command not found`, and a Dockerfile with CRLF breaks its
#  RUN lines — both a long way from anything that looks like a line
#  ending problem.
# ============================================================

# Normalise text to LF in the repository. The working tree still follows
# the platform, so Windows editors keep behaving as they do today.
* text=auto

# ---- Must be LF in the working tree too ----
# These are run by Linux, in the container or on a CI runner.
*.sh            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
*.toml          text eol=lf

# ---- Never touch ----
*.png  binary
*.jpg  binary
*.ico  binary
*.pdf  binary
*.db   binary
*.node binary
