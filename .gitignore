# ── Dependencies ────────────────────────────────────────────
# The browser side is dependency-free. The server needs @anthropic-ai/sdk,
# so package-lock.json IS committed — it pins the version the agent was
# tested against.
node_modules/
yarn.lock
npm-debug.log*
yarn-error.log*
.npm/

# ── Environment & secrets ───────────────────────────────────
# The voice agent needs ANTHROPIC_API_KEY, read from the environment by
# serve.js. Never put it in a committed file, and never in the client-side
# JavaScript this repo ships — view-source is all it takes to lift it.
.env
.env.local
.env.*.local
# .env.example is the committed template — it holds a placeholder, not a key
!.env.example
*.pem
*.key

# ── Editor & tooling ────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code per-user overrides. Shared project settings
# (.claude/settings.json) may be committed; local ones must not.
.claude/settings.local.json

# ── OS artefacts ────────────────────────────────────────────
# This project lives in a OneDrive folder, so desktop.ini and Office
# lock files turn up regularly.
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
~$*
*.tmp

# ── Logs & local output ─────────────────────────────────────
*.log
logs/
coverage/
.nyc_output/
